# Filesystem-name protection layered over the fixed namespace/native guard.
# This does not yet protect the complete ELF/helper/loader dependency closure.
profile mano-package-worker flags=(mediate_deleted) {
  /** mrwlkix,
  capability chown,
  capability dac_override,
  capability fowner,
  capability fsetid,
  capability setuid,
  capability setgid,
  # Needed only by the fixed native guard; absent after its bounding-set drop.
  capability setpcap,
  network,
  signal,
  ptrace (readby) peer=unconfined,

  # Protect the name as well as the target of the system interpreter symlink.
  deny /{usr/,}bin/python3{,.*} wkl,
  deny /usr/ w,
  deny /usr/bin/ w,
  deny /usr/lib/ w,
  deny /usr/lib/python3*/ w,
  deny /usr/lib/python3*/** wkl,
  # Python searches this name even when no zip exists at sandbox construction.
  deny /usr/lib/python3*.zip wkl,
  deny /usr/local/ w,
  deny /usr/local/** wkl,
  deny /etc/python3* wkl,
  deny /etc/python3*/ w,
  deny /etc/python3*/** wkl,

  # Fixed privileged helpers used for catalog, recovery and runtime lifecycle.
  # Protect command names; this is not their transitive ELF/loader closure.
  deny /{usr/,}bin/{btrfs,bwrap,dpkg-deb,dpkg-query,findmnt,gpgv*,mount,passwd,snapper,systemctl,systemd-sysusers,systemd-tmpfiles,umount} wkl,
  deny /{usr/,}sbin/{runuser,usermod} wkl,
  deny /usr/lib/apt/ w,
  deny /usr/lib/apt/** wkl,
  # The signed catalog's trust input must not be replaced by a package script.
  deny /usr/share/keyrings/ w,
  deny /usr/share/keyrings/** wkl,

  # Masking only an existing preload file leaves an absent name creatable.
  deny /etc/ld.so.preload wkl,

  # Observed fixed-helper/Python ELF names, including future ABI versions.
  # This is name protection, not loader-cache or complete plugin closure.
  deny /usr/lib/x86_64-linux-gnu/ w,
  deny /usr/lib/x86_64-linux-gnu/systemd/ w,
  deny /usr/lib64/ w,
  deny /{usr/,}lib{,64}/{,**/}ld-linux-x86-64.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libacl.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libapt-pkg.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libapt-private.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libattr.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libaudit.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libblkid.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libboost_thread.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libbsd.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libbtrfs.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libbz2.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libc.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libcap-ng.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libcap.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libcrypt.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libcrypto.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libdb-5.3.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libdbus-1.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libexpat.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libffi.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libgcc_s.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libgcrypt.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libgpg-error.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libjson-c.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}liblz4.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}liblzma.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}liblzo2.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libm.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libmd.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libmount.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libncursesw.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libpam.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libpam_misc.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libpanelw.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libpcre2-8.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libreadline.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libselinux.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libsemanage.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libsepol.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libsmartcols.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libsnapper.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libsqlite3.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libssl.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libstdc++.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libsystemd.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libtinfo.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libudev.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libuuid.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libxml2.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libxxhash.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libz.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libzstd.so* wkl,
  deny /{usr/,}lib{,64}/{,**/}libsystemd-shared-*.so* wkl,

  # No script can change the policy, its loader or its current execution label.
  deny /{usr/,}bin/aa-exec wkl,
  deny /{usr/,}sbin/apparmor_parser wkl,
  deny /etc/apparmor.d/ w,
  deny /etc/apparmor.d/** wkl,
  deny /var/cache/apparmor/ w,
  deny /var/cache/apparmor/** wkl,
  deny /proc/**/attr/** w,
  deny /sys/kernel/security/** w,
}
